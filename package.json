{
  "name": "mbu",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "sync:badges": "bun scripts/sync-requirements-hybrid.ts",
    "detect:links": "bun scripts/detect-related-badges.ts",
    "build:local": "rm -rf hugo/public && cd hugo && hugo && bun run index",
    "build": "cd hugo && hugo --minify && bun run index",
    "hugo:dev": "cd hugo && hugo server",
    "index": "bunx pagefind --site hugo/public",
    "generate:drg-images": "bun scripts/generate-drg-images.ts --badge"
  },
  "devDependencies": {
    "@google/genai": "^1.41.0",
    "@mendable/firecrawl-js": "^4.12.1",
    "@types/bun": "latest",
    "firebase-tools": "^15.6.0",
    "js-yaml": "^4.1.1",
    "pagefind": "^1.4.0",
    "prettier": "^3.8.1",
    "prettier-plugin-go-template": "^0.0.15",
    "prettier-plugin-organize-imports": "^4.3.0",
    "sharp": "^0.34.5",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "impit": "^0.7.6",
    "slugify": "^1.6.6"
  }
}
