{
  "name": "mbu",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "sync:badges": "bun scripts/sync-requirements-api.ts",
    "sync:badges:api": "bun scripts/sync-requirements-api.ts",
    "sync:badges:firecrawl": "bun scripts/sync-requirements-hybrid.ts",
    "patch:categories": "bun scripts/patch-categories.ts",
    "patch:frontmatter-categories": "bun scripts/patch-frontmatter-categories.ts",
    "add:schema": "bun scripts/add-schema-property.ts",
    "detect:links": "bun scripts/detect-related-badges.ts",
    "audit:badge-json": "bun scripts/audit-badge-json.ts",
    "list:categories": "bun scripts/list-categories.ts",
    "lint": "oxlint .",
    "build:local": "rm -rf hugo/public && cd hugo && hugo && bun run index",
    "build": "cd hugo && hugo --minify && bun run index",
    "hugo:dev": "cd hugo && hugo server",
    "index": "bunx pagefind --site hugo/public",
    "generate:drg-images": "bun scripts/generate-drg-images.ts --badge",
    "convert:drg-images": "bun scripts/convert-drg-images-to-avif.ts",
    "verify:youtube-links": "bun scripts/verify-youtube-links.ts",
    "search:youtube-videos": "bun scripts/search-youtube-videos.ts",
    "verify:drg-resources": "bun scripts/verify-drg-resources.ts",
    "verify:drg-requirements": "bun scripts/verify-drg-requirements.ts",
    "scaffold:drg": "bun scripts/scaffold-drg.ts",
    "drg:coverage": "bun scripts/drg-coverage.ts",
    "search:pdf": "python3 scripts/search-pdf.py"
  },
  "devDependencies": {
    "@google/genai": "^1.50.1",
    "@mendable/firecrawl-js": "^4.19.0",
    "@types/bun": "^1.3.13",
    "firebase-tools": "^15.15.0",
    "oxlint": "^1.61.0",
    "oxlint-tsgolint": "^0.21.1",
    "pagefind": "^1.5.2",
    "prettier": "^3.8.3",
    "prettier-plugin-go-template": "^0.0.15",
    "prettier-plugin-organize-imports": "^4.3.0",
    "sharp": "^0.34.5",
    "typescript": "^6.0.3",
    "zod": "^4.3.6"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "slugify": "^1.6.9",
    "youtube-sr": "^4.3.12"
  }
