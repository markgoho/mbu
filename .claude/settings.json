{
  "permissions": {
    "allow": [
      "Bash(acli jira workitem view:*)",
      "Bash(acli jira workitem search:*)",
      "WebFetch(domain:polarity.cisco.com)",
      "Bash(acli jira workitem edit:*)",
      "Bash(bun run:*)",
      "Bash(lsof:*)",
      "Bash(xargs kill:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(git fetch:*)",
      "Bash(git checkout:*)"
    ],
    "deny": [],
    "ask": []
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start-tts.sh"
          }
        ]
      }
    ]
  },
  "$schema": "https://json.schemastore.org/claude-code-settings.json"
}