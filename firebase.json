{
  "firestore": {
    "database": "(default)",
    "location": "us-east4",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "hosting": [
    {
      "target": "main-site",
      "public": "hugo/public",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "redirects": [
        {
          "source": "/worksheets/:slug-worksheet.pdf",
          "destination": "/merit-badges/:slug/:slug-merit-badge-worksheet.pdf",
          "type": 301
        },
        {
          "source": "/worksheets/:slug.pdf",
          "destination": "/merit-badges/:slug/:slug-merit-badge-worksheet.pdf",
          "type": 301
        },
        {
          "source": "/merit-badges/familylife/:rest*",
          "destination": "/merit-badges/family-life/:rest*",
          "type": 301
        },
        {
          "source": "/contact-us{,/**}",
          "destination": "/",
          "type": 301
        }
      ],
      "headers": [
        {
          "source": "**/*.avif",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=2592000, immutable"
            }
          ]
        },
        {
          "source": "**/*.woff2",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=2592000, immutable"
            }
          ]
        },
        {
          "source": "**/*.woff",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=2592000, immutable"
            }
          ]
        },
        {
          "source": "**/*.css",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=2592000, immutable"
            }
          ]
        },
        {
          "source": "**",
          "headers": [
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://api.pirsch.io; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://www.scouting.org https://filestore.scouting.org https://api.pirsch.io; frame-src https://www.youtube.com https://www.youtube-nocookie.com; frame-ancestors 'none';"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            }
          ]
        }
      ]
    },
    {
      "target": "app-site",
      "public": "app/dist/app/browser",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "/api/health{,/**}",
          "function": "healthApi",
          "region": "us-east4"
        },
        {
          "source": "/api/users{,/**}",
          "function": "usersApi",
          "region": "us-east4"
        },
        {
          "source": "/api/universities{,/**}",
          "function": "universitiesApi",
          "region": "us-east4"
        },
        {
          "source": "/api/admin/universities{,/**}",
          "function": "universitiesApi",
          "region": "us-east4"
        },
        {
          "source": "/api/registrations{,/**}",
          "function": "registrationsApi",
          "region": "us-east4"
        },
        {
          "source": "/api/retention{,/**}",
          "function": "retentionApi",
          "region": "us-east4"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            },
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'self'; script-src 'self' https://apis.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com; frame-src 'self' https://merit-badge-university.firebaseapp.com https://accounts.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self';"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            }
          ]
        }
      ]
    }
  ],
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8090
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  }
}
