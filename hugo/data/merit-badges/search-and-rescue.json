    {
      "req_id": "7",
      "path": "7",
      "text": "Plan and Complete a Search. Do the following with a team of Scouts, friends, or family to execute a practice SAR exercise:",
      "subrequirements": [
        {
          "req_id": "a",
          "path": "7.a",
          "text": "Choose a hypothetical SAR scenario, either one presented in the Search and Rescue merit badge pamphlet or one approved by your counselor.",
          "resources": [
            {
              "title": "Training Scenarios (website)",
              "url": "https://www.countyofglenn.net/government/departments/sheriff/search-rescue/training-response-activities"
            },
            {
              "title": "Lost Scout Scenario (PDF)",
              "url": "https://filestore.scouting.org/filestore/Merit_Badge_ReqandRes/Requirement%20Resources/Search%20and%20Rescue/Lost%20Scout%20Scenario.pdf"
            }
          ]
        },
        {
          "req_id": "b",
          "path": "7.b",
          "text": "Develop an Incident Action Plan (IAP) for a hasty search using the scenario information.",
          "resources": [
            {
              "title": "Developing an IAP (PDF)",
              "url": "https://www.sarbc.org/sarbc/pdfs/SearchMgmtActionPlan.pdf"
            }
