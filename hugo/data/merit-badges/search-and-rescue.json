    {
      "req_id": "2",
      "path": "2",
      "text": "Staying and Getting Found. Do the following:",
      "subrequirements": [
        {
          "req_id": "a",
          "path": "2.a",
          "text": "Explain how a trip plan and the buddy system help Scouts with staying found and getting found.",
          "resources": [
            {
              "title": "How To Plan an Adventure (video)",
              "url": "https://youtu.be/79WYqkiExZU"
            },
            {
              "title": "Scout Trip Planning (website)",
              "url": "https://scoutingmagazine.org/2007/03/outdoor-smarts-lost-and-found/"
            },
            {
              "title": "Why You Should Make Trip Plans (website)",
              "url": "https://www.adventurealan.com/why-you-should-make-a-trip-plan/"
            }
          ]
        },
        {
          "req_id": "b",
          "path": "2.b",
          "text": "Explain how seasonal and daily weather changes affect Trip Plans.",
          "resources": [
            {
              "title": "Search and Rescue Expert Stresses Importance of Preparedness (video)",
              "url": "https://youtu.be/CLQo5ftVqnc"
            }
          ]
        },
        {
          "req_id": "c",
          "path": "2.c",
          "text": "Explain and show how a lost Scout could send signals that would alert a ground, airborne, or water SAR team to their location.",
          "resources": [
            {
              "title": "5 Ground To Air Signals That Save Lives (video)",
              "url": "https://youtube.com/shorts/Srj6Cy6D0YU"
            },
            {
              "title": "Various Ways To Signal for Search and Rescue (video)",
              "url": "https://youtu.be/6ZDiIfqTI-k"
            },
            {
              "title": "Signaling for Help in the Wilderness (website)",
              "url": "https://scoutingmagazine.org/2019/02/signaling-for-help-in-the-wilderness/"
            }
          ]
        },
        {
          "req_id": "d",
          "path": "2.d",
          "text": "Demonstrate how to use a signaling mirror.",
          "resources": [
            {
              "title": "How To Use a Signal Mirror (video)",
              "url": "https://youtu.be/kYN46GuZmpE"
            },
            {
              "title": "The Signal Mirror: A Low-Tech Lifesaver (website)",
              "url": "https://scoutingmagazine.org/issues/0103/d-outs.html"
            }
          ]
        },
        {
          "req_id": "e",
          "path": "2.e",
          "text": "Explain how a Personal Locator Beacon (PLB) works and the role of the Air Force Rescue Coordination Center (AFRCC).",
