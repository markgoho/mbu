    {
      "req_id": "3",
      "path": "3",
      "text": "Maps. Using a map, a compass and a GPS device or app approved by your counselor, do the following:",
      "subrequirements": [
        {
          "req_id": "a",
          "path": "3.a",
          "text": "Point out and explain the 5 D's (Date, Description, Details, Direction or Declination, Distance) of the map.",
          "resources": [
            {
              "title": "The 5 D's in Navigation (video)",
              "url": "https://youtu.be/0zbCEXj_29U"
            },
            {
              "title": "The Five D's in Map Navigation (website)",
              "url": "https://mountaintrails.ie/blog/using-the-five-ds-in-a-navigation-strategy/"
            }
          ]
        },
        {
          "req_id": "b",
          "path": "3.b",
          "text": "Choose a location on the map and record the altitude, latitude, longitude, and US National Grid coordinates. Describe how these coordinate systems differ.",
          "resources": [
            {
              "title": "How To Read a US National Grid Map (website)",
              "url": "https://www.fgdc.gov/usng/how-to-read-usng/index_html"
            },
            {
              "title": "Work With a Grid in ArcGIS Pro (video)",
              "url": "https://youtu.be/Tm-k5d3Ar54"
            }
          ]
        },
        {
          "req_id": "c",
          "path": "3.c",
          "text": "Orient the map and take a bearing to another map location. Estimate the distance between, and describe the terrain between, the two locations.",
          "resources": [
            {
              "title": "How To Use a Map and Compass (website)",
              "url": "https://troopleader.scouting.org/rank-advancement-skills/campcraft/navigation-and-measurements/"
            }
          ]
        },
        {
          "req_id": "d",
          "path": "3.d",
          "text": "Show a hypothetical place last seen and point out an area on your map that could be used for containment using natural or human-made boundaries.",
          "resources": [
            {
              "title": "Search Containment (video)",
              "url": "https://www.youtube.com/shorts/-fbXrnZ0C3o"
            }
          ]
        }
      ],
      "subrequirement_mode": {
        "type": "all"
      }
    },
