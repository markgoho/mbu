{
  "$schema": "../../static/schemas/merit-badge.schema.json",
  "title": "Moviemaking",
  "slug": "moviemaking",
  "url": "https://www.scouting.org/merit-badges/moviemaking/",
  "eagle_required": false,
  "category": "Communications",
  "pamphlet_url": "https://filestore.scouting.org/filestore/Merit_Badge_ReqandRes/Pamphlets/Moviemaking.pdf",
  "last_updated": "2026-03-28",
  "requirements": [
    {
      "req_id": "1",
      "path": "1",
      "text": "Discuss and demonstrate the proper elements of a good motion picture. In your discussion, include visual storytelling, rhythm, the 180-axis rule, camera movement, framing and composition of camera shots, and lens selection.",
      "resources": [
        {
          "title": "Film Making Basics (video)",
          "url": "https://youtu.be/BFwMRVwrKcA?si=uW4whxq0-SZjyFHJ"
        }
      ]
    },
    {
      "req_id": "2",
      "path": "2",
      "text": "Do the following:",
      "subrequirements": [
        {
          "req_id": "a",
          "path": "2.a",
          "text": "In a three- or four-paragraph treatment, tell the story you plan to produce, making sure that the treatment conveys a visual picture.",
          "resources": [
            {
              "title": "Film Production Explained, Each Step of the Production Process (video)",
              "url": "https://youtu.be/puF9CkvmJt0?si=jiFW5a-I3X0vZDV4"
            }
          ]
        },
        {
          "req_id": "b",
          "path": "2.b",
          "text": "Prepare a storyboard for your motion picture. Note: This can be done with rough sketches and stick figures.",
          "resources": [
            {
              "title": "What Is a Storyboard and Why Is It Important? Pre-Production Filmmaking (video)",
              "url": "https://youtu.be/yPtqHdQcOOw?si=24Rdiz36nJTayneu"
            }
          ]
        },
        {
          "req_id": "c",
          "path": "2.c",
          "text": "Demonstrate the following motion picture shooting techniques:",
          "subrequirements": [
            {
              "req_id": "1",
              "path": "2.c.1",
              "text": "Using a tripod",
              "resources": [
                {
                  "title": "7 Tripod Tricks for Filmaking (video)",
                  "url": "https://youtu.be/pAvn034VcCg"
                }
              ]
            },
            {
              "req_id": "2",
              "path": "2.c.2",
              "text": "Panning a camera",
              "resources": [
                {
                  "title": "Camera Panning (video)",
                  "url": "https://youtu.be/Km7Rfpda_Lw"
                }
              ]
            },
            {
              "req_id": "3",
              "path": "2.c.3",
              "text": "Framing a shot",
              "resources": [
                {
                  "title": "Reverse Shot (video)",
                  "url": "https://youtu.be/5UE3jz_O_EM"
                },
                {
                  "title": "Frame it Right Essential Framing (short video)",
                  "url": "https://www.youtube.com/shorts/DAwz2Wnrr90?feature=share"
                }
              ]
            },
            {
              "req_id": "4",
              "path": "2.c.4",
              "text": "Selecting an angle",
              "resources": [
                {
                  "title": "Filmmaking 101: 5 Camera Angles (video)",
                  "url": "https://youtu.be/nfHvSnILXl0?si=9ObCi1MwUvu3CHyW"
                },
                {
                  "title": "12 CAMERA ANGLES to Enhance Your Films (video)",
                  "url": "https://youtu.be/SlNviMsi0K0"
                }
              ]
            },
            {
              "req_id": "5",
              "path": "2.c.5",
              "text": "Selecting proper lighting",
              "resources": [
                {
                  "title": "Ultimate Guide to Cinematic Lighting (video)",
                  "url": "https://youtu.be/r2nD_knsNrc"
                },
                {
                  "title": "Zack Snyder Justice League Martian Man Hunter Meets Lois (video)",
                  "url": "https://youtu.be/zdZ2zza5WbY?si=m3eF-8tZrS-NaOC5"
                }
              ]
            },
            {
              "req_id": "6",
              "path": "2.c.6",
              "text": "Handheld shooting",
              "resources": [
                {
                  "title": "5 Tips for Shooting Handheld Videos (video)",
                  "url": "https://youtu.be/LuJdvwm8-0k"
                },
                {
                  "title": "Birdman: Anatomy of a Scene (video)",
                  "url": "https://youtu.be/PVmaJAmQ3yQ"
                }
              ]
            }
          ],
          "subrequirement_mode": {
            "type": "all"
          }
        },
        {
          "req_id": "d",
          "path": "2.d",
          "text": "Using motion picture shooting techniques, plan ONE of the following programs. Start with a treatment and complete the requirement by presenting this program to a pack or your troop, patrol, or class.",
          "subrequirements": [
            {
              "req_id": "1",
              "path": "2.d.1",
              "text": "Film a court of honor and show it to an audience.",
              "resources": [
                {
                  "title": "4 Videography Tips for Beginners (video)",
                  "url": "https://youtu.be/oPfet0ypjmY?si=flKBth5nUkcFZelI"
                }
              ]
            },
            {
              "req_id": "2",
              "path": "2.d.2",
              "text": "Create a short feature of your own design, using the techniques you learned.",
              "resources": [
                {
                  "title": "10 Tips for Beginner Videographers (video)",
                  "url": "https://youtu.be/kZWH6OBDdR0?si=e1VBvG2lGwQHKqEY"
                }
              ]
            },
            {
              "req_id": "3",
              "path": "2.d.3",
              "text": "Shoot a vignette that could be used to train a new Scout in a Scouting skill.",
              "resources": [
                {
                  "title": "How to Make a Great Instructional Video (video)",
                  "url": "https://youtu.be/cLLuuV_57JY?si=vcdpLOuyRcHeC1jf"
                }
              ]
            }
          ],
          "subrequirement_mode": {
            "type": "select",
            "count": 1
          }
        }
      ],
      "subrequirement_mode": {
        "type": "all"
      }
    },
    {
      "req_id": "3",
      "path": "3",
      "text": "Do ONE of the following:",
      "subrequirements": [
        {
          "req_id": "a",
          "path": "3.a",
          "text": "With your parent or guardian's permission and your counselor's approval, visit a film set or television production studio and watch how production work is done.",
          "resources": [
            {
              "title": "Film Set Order of Operations (video)",
              "url": "https://youtu.be/zqUAiM-FLrs?si=xK2hkF_sD9zCzGcM"
            }
          ]
        },
        {
          "req_id": "b",
          "path": "3.b",
          "text": "Explain to your counselor the elements of the zoom lens and three important parts.",
          "resources": [
            {
              "title": "How Lens Work in Camera (video)",
              "url": "https://youtu.be/fRKsKR9wvqE"
            },
            {
              "title": "The Parts of a Camera Lens - Anatomy of a DSLR Lens (video)",
              "url": "https://youtu.be/15h9iG-Rdwk?si=TUp4-HL00H50ZX79"
            }
          ]
        }
      ],
      "subrequirement_mode": {
        "type": "select",
        "count": 1
      }
    },
    {
      "req_id": "4",
      "path": "4",
      "text": "Do ONE of the following:",
      "subrequirements": [
        {
          "req_id": "a",
          "path": "4.a",
          "text": "Explore careers related to this merit badge. Research one career to learn about the training and education needed, costs, job prospects, salary, job duties, and career advancement. Your research methods may include—with your parent or guardian's permission—an internet or library search, an interview with a professional in the field, or a visit to a location where people in this career work. Discuss with your counselor both your findings and what about this profession might make it an interesting career.",
          "resources": [
            {
              "title": "Top 10 Careers in Film & Video Production (video)",
              "url": "https://youtu.be/CNMBMhNh2S0"
            }
          ]
        },
        {
          "req_id": "b",
          "path": "4.b",
          "text": "Explore how you could use knowledge and skills from this merit badge to pursue a hobby or healthy lifestyle. Research any training needed, expenses, and organizations that promote or support it. Discuss with your counselor what short-term and long-term goals you might have if you pursued this.",
          "resources": [
            {
              "title": "Filmmaking as a Hobby - Getting Started (video)",
              "url": "https://youtu.be/d30kfqueNKI"
            }
          ]
        }
      ],
      "subrequirement_mode": {
        "type": "select",
        "count": 1
      }
    }
  ]
}