  "requirements": [
    {
      "req_id": "1",
      "path": "1",
      "text": "Laws and Society. Discuss the following with your counselor:",
      "subrequirements": [
        {
          "req_id": "a",
          "path": "1.a",
          "text": "Why we have criminal laws.",
          "resources": [
            {
              "title": "The Purposes of Criminal Law (video)",
              "url": "https://youtu.be/j9IvbB50YB0"
            }
          ]
        },
        {
          "req_id": "b",
          "path": "1.b",
          "text": "What are types of crimes, including property crimes, crimes against people, white collar crime, and environmental crime.",
          "resources": [
            {
              "title": "7 Types of Crime (video)",
              "url": "https://youtu.be/BSyY9RRR6ds"
            }
          ]
        },
        {
          "req_id": "c",
          "path": "1.c",
          "text": "Why people commit crimes.",
          "resources": [
            {
              "title": "Why Do People Commit Crimes? (video)",
              "url": "https://youtu.be/1FD7aMivAek"
            }
          ]
        },
        {
          "req_id": "d",
          "path": "1.d",
          "text": "Why everyone should follow the law even when no one is watching.",
          "resources": [
            {
              "title": "Why Do We Obey Laws? The Social Contract (video)",
              "url": "https://youtu.be/PgaLe64jUJk?si=X49W-2QPhOORpk9o"
            },
            {
              "title": "Our Social Contract to Follow the Law (video)",
              "url": "https://youtu.be/Ax2Ig6Y9Ve4?si=BL7BGjL2Flj6DSyV"
            }
          ]
        },
        {
          "req_id": "e",
          "path": "1.e",
          "text": "What is the meaning of crime prevention.",
          "resources": [
            {
              "title": "What is Crime Prevention? (video)",
              "url": "https://youtu.be/RbObl2KKU7A?si=03soZBeN05po0MOv"
            },
            {
              "title": "Basic Crime Prevention (video)",
              "url": "https://youtu.be/PS1RmeyTSD0?si=OoWp68p1BqHgG9Hj"
            }
          ]
        }
      ],
      "subrequirement_mode": {
        "type": "all"
      }
    },
    {
