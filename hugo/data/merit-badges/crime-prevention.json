            },
            {
              "title": "How Sport Helps to Prevent Crime (video)",
              "url": "https://youtu.be/eVZ-NOoyIIE?si=h1_TsiWRVwr42Kg9"
            }
          ]
        },
        {
          "req_id": "b",
          "path": "2.b",
          "text": "Schools",
          "resources": [
            {
              "title": "Education Efforts Could Prevent Crime (video)",
              "url": "https://youtu.be/qvjG3lmM3Gk"
            },
            {
              "title": "Preventing Crime with Education (video)",
              "url": "https://youtu.be/RkMHmdFPkI0?si=kNVJpoq5KCe6R8EC"
            }
