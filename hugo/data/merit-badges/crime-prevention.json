    {
      "req_id": "10",
      "path": "10",
      "text": "Interview. With your parent or guardian's permission and your counselor's approval, interview a law enforcement officer or a civil servant about their work in crime prevention. Learn about how they chose this career and about their duties. Discuss what you learned with your counselor."
    },
    {
      "req_id": "11",
      "path": "11",
      "text": "Careers. Identify three career opportunities that would use skills and knowledge in the field of crime prevention. Pick one and research the training, education, certification requirements, experience, and expenses associated with entering the field. Research the prospects for employment, starting salary, advancement opportunities and career goals associated with this career. Discuss what you learned with your counselor and whether you might be interested in this career.",
      "resources": [
        {
          "title": "8 Careers in Criminal Justice (video)",
          "url": "https://youtu.be/eqTjWF4GRm0?si=rRKOb3rTcAHM4CpT"
        },
        {
          "title": "How Law Enforcement Agencies Serve the Public (video)",
          "url": "https://youtu.be/kR-yLbFoR9A?si=gdzqOCdcfn32XOD_"
        }
      ]
    }
