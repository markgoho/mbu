          "path": "2.d",
          "text": "Private security",
          "resources": [
            {
              "title": "Security Guards Reduce Crime in LA (video)",
              "url": "https://youtu.be/EGPbHVf-rXc?si=dPcuFJxAjOw8SxE2"
            },
            {
              "title": "Private Security and Crime Prevention (video)",
              "url": "https://youtu.be/sWHSndoE1U0?si=oOYuRrMomUJShgYY"
            }
          ]
        },
        {
          "req_id": "e",
          "path": "2.e",
          "text": "Law enforcement agencies",
