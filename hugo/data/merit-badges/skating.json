{
  "$schema": "../../static/schemas/merit-badge.schema.json",
  "title": "Skating",
  "slug": "skating",
  "url": "https://www.scouting.org/merit-badges/skating/",
  "eagle_required": false,
  "category": "Sports",
  "pamphlet_url": "https://filestore.scouting.org/filestore/Merit_Badge_ReqandRes/Pamphlets/Skating.pdf",
  "last_updated": "2026-03-29",
  "requirements": [
    {
      "req_id": "1",
      "path": "1",
      "text": "Do the following:",
      "subrequirements": [
        {
          "req_id": "a",
          "path": "1.a",
          "text": "Explain to your counselor the most likely hazards associated with skating and what you should do to anticipate, help prevent, mitigate, and respond to these hazards.",
          "resources": [
            {
              "title": "Skateboard Safety (website)",
              "url": "https://www.scouting.org/health-and-safety/safety-moments/skateboard-safety/"
            }
          ]
        },
        {
          "req_id": "b",
          "path": "1.b",
          "text": "Show that you know first aid for injuries or illnesses that could occur while skating, including hypothermia, frostbite, lacerations, abrasions, fractures, sprains and strains, concussions, blisters, heat-related reactions, and shock.",
          "resources": [
            {
              "title": "Skating Injuries - Types and Prevention (website)",
              "url": "https://www.icliniq.com/articles/first-aid-and-emergencies/skating-injuries"
            }
          ]
        }
      ],
      "subrequirement_mode": {
        "type": "all"
      }
    },
    {
      "req_id": "2",
      "path": "2",
      "text": "Working under the supervision of an experienced adult, do ONE of the following options.",
      "subrequirements": [
        {
          "req_id": "a",
          "path": "2.a",
          "text": "Option A—Ice Skating. Do ALL of the following:",
          "is_option": true,
          "resources": [
            {
              "title": "How to Play Figure Skating (video)",
              "url": "https://youtu.be/-53axkfHUHk"
            },
            {
              "title": "How to Ice Skate (video)",
              "url": "https://youtu.be/8uDfC7sZ7ag"
            }
          ],
          "subrequirements": [
            {
              "req_id": "1",
              "path": "2.a.1",
              "text": "Explain the general safety and courtesy guidelines for ice skating."
            },
            {
              "req_id": "2",
              "path": "2.a.2",
              "text": "Discuss preparations that must be taken when skating outdoors on natural ice. Explain how to make an ice rescue.",
              "resources": [
                {
                  "title": "How To Know if Ice Is Safe To Walk On (video)",
                  "url": "https://youtu.be/KmYeulVH8IE"
                },
                {
                  "title": "Ice Safety (website)",
                  "url": "https://dnr.wisconsin.gov/Education/OutdoorSkills/IceSafety"
                },
                {
                  "title": "Test Ice Thickness (video)",
                  "url": "https://youtu.be/BWLvW-d5jBY"
                },
                {
                  "title": "How to Save Someone Who Falls Through Ice (video)",
                  "url": "https://youtu.be/yVXJQq41tTA"
                }
              ]
            },
            {
              "req_id": "3",
              "path": "2.a.3",
              "text": "Discuss the parts and functions of the different types of ice skates.",
              "resources": [
                {
                  "title": "Figure Skates vs. Hockey Skates (video)",
                  "url": "https://youtu.be/H6hUVU57Wpk"
                }
              ]
            },
            {
              "req_id": "4",
              "path": "2.a.4",
              "text": "Describe the proper way to carry ice skates at the rink and for travel."
            },
            {
              "req_id": "5",
              "path": "2.a.5",
              "text": "Describe how to store ice skates for long periods of time, such as seasonal storage.",
              "resources": [
                {
                  "title": "How Do I Store My Skates Correctly? (video)",
                  "url": "https://youtu.be/xCibThdzynI"
                },
                {
                  "title": "Care for Your Ice Skates (website)",
                  "url": "https://www.skatepro.ca/en/a65.htm"
                }
              ]
            },
            {
              "req_id": "6",
              "path": "2.a.6",
              "text": "Skate forward at least 40 feet and come to a complete stop. Use either a two-foot snowplow stop or a one-foot snowplow stop.",
              "resources": [
                {
                  "title": "Snowplow Stop (video)",
                  "url": "https://youtu.be/rhQY1_bTjVs"
                }
              ]
            },
            {
              "req_id": "7",
              "path": "2.a.7",
              "text": "After skating forward, glide forward on two feet, then on one foot, first right and then left.",
              "resources": [
                {
                  "title": "Forward Stroking (video)",
                  "url": "https://youtu.be/-7QqRz2EZAM"
                }
              ]
            },
            {
              "req_id": "8",
              "path": "2.a.8",
              "text": "Starting from a T position, stroke forward around the test area, avoiding the use of toe picks if wearing figure skates.",
              "resources": [
                {
                  "title": "Forward From a T Position (video)",
                  "url": "https://youtu.be/-7QqRz2EZAM&t=516"
                }
              ]
            },
            {
              "req_id": "9",
              "path": "2.a.9",
              "text": "Glide backward on two feet for at least two times the skater's height.",
              "resources": [
                {
                  "title": "Skate Backward (video)",
                  "url": "https://youtu.be/dZsfWfYxqzw"
                }
              ]
            },
            {
              "req_id": "10",
              "path": "2.a.10",
              "text": "Skate backward for at least 20 feet on two skates."
            },
            {
              "req_id": "11",
              "path": "2.a.11",
              "text": "After gaining forward speed, glide forward on two feet, making a turn of 180 degrees around a cone, first to the right and then to the left.",
              "resources": [
                {
                  "title": "Turns Around a Cone (video)",
                  "url": "https://youtu.be/Lm1PXq9iFog"
                }
              ]
            },
            {
              "req_id": "12",
              "path": "2.a.12",
              "text": "Perform forward crossovers in a figure-eight pattern.",
              "resources": [
                {
                  "title": "How To Do Back Crossovers in a Figure 8 (video)",
                  "url": "https://youtu.be/krBVgF52z8M"
                }
              ]
            },
            {
              "req_id": "13",
              "path": "2.a.13",
              "text": "Explain to your counselor the safety considerations for participating in an ice-skating race.",
              "resources": [
                {
                  "title": "How Speed Skaters Stay Safe on the Ice (website)",
                  "url": "https://healthcare.utah.edu/healthfeed/2022/02/how-speed-skaters-stay-safe-ice"
                },
                {
                  "title": "Safety Tips: Ice Skating (website)",
                  "url": "https://kidshealth.org/en/parents/safety-ice-skating.html"
                }
              ]
            },
            {
              "req_id": "14",
              "path": "2.a.14",
              "text": "Perform a hockey stop.",
              "resources": [
                {
                  "title": "Perform a Hockey Stop (video)",
                  "url": "https://youtu.be/nIfU38nAYYk"
                }
              ]
            }
          ],
          "subrequirement_mode": {
            "type": "all"
          }
        },
        {
          "req_id": "b",
          "path": "2.b",
          "text": "Option B—Roller Skating. Do ALL of the following:",
          "is_option": true,
          "subrequirements": [
            {
              "req_id": "1",
              "path": "2.b.1",
              "text": "Explain the general safety rules and etiquette guidelines for roller skating.",
              "resources": [
                {
                  "title": "Getting Started with Roller Skating (video)",
                  "url": "https://youtu.be/eXzKkXQCY_Q"
                }
              ]
            },
            {
              "req_id": "2",
              "path": "2.b.2",
              "text": "Discuss the parts and functions of a roller skate and their functions."
            },
            {
              "req_id": "3",
              "path": "2.b.3",
              "text": "Describe five essential steps to good roller skate care."
            },
            {
              "req_id": "4",
              "path": "2.b.4",
              "text": "Skate forward with smooth, linked strokes on two feet for at least 100 feet in both directions around the rink and demonstrate proper techniques for stopping.",
              "resources": [
                {
                  "title": "Skating Forward (video)",
                  "url": "https://youtu.be/znYKw5GQZVA"
                }
              ]
            },
            {
              "req_id": "5",
              "path": "2.b.5",
              "text": "Skate forward and glide at least 15 feet on one skate, then on the other skate."
            },
            {
              "req_id": "6",
              "path": "2.b.6",
              "text": "Perform a forward crossover.",
              "resources": [
                {
                  "title": "Skating Crossovers (video)",
                  "url": "https://youtu.be/VrgT9TPLANY"
                }
              ]
            },
            {
              "req_id": "7",
              "path": "2.b.7",
              "text": "Skate backward for at least 40 feet on two skates, then for at least 15 feet on one skate.",
              "resources": [
                {
                  "title": "Roller Skating Backwards (video)",
                  "url": "https://youtu.be/c7MLviMbw6A"
                }
              ]
            },
            {
              "req_id": "8",
              "path": "2.b.8",
              "text": "Skate forward in a slalom pattern for at least 40 feet on two skates, then for at least 20 feet on one skate."
            },
            {
              "req_id": "9",
              "path": "2.b.9",
              "text": "Skate backward in a slalom pattern for at least 15 feet on two skates."
            },
            {
              "req_id": "10",
              "path": "2.b.10",
              "text": "Shuttle skate once around the rink, bending twice along the way, without stopping."
            },
            {
              "req_id": "11",
              "path": "2.b.11",
              "text": "Perform a series of two consecutive spins on skates, OR hop, skip, and jump on skates for at least 10 feet.",
              "resources": [
                {
                  "title": "Roller Skating Two-Foot Spins (video)",
                  "url": "https://youtu.be/d6Z91xZXNxE"
                }
              ]
            },
            {
              "req_id": "12",
              "path": "2.b.12",
              "text": "Perform a stepover."
            },
            {
              "req_id": "13",
              "path": "2.b.13",
              "text": "While skating, dribble a basketball at least 40 feet, then back to your starting position, OR push a hockey ball with a stick at least 40 feet, then back to your starting position."
            }
          ],
          "subrequirement_mode": {
            "type": "all"
          }
        },
        {
          "req_id": "c",
          "path": "2.c",
          "text": "Option C—In-Line Skating. Do ALL of the following:",
          "is_option": true,
          "subrequirements": [
            {
              "req_id": "1",
              "path": "2.c.1",
              "text": "Explain the general safety rules and courtesy guidelines for in-line skating."
            },
            {
              "req_id": "2",
              "path": "2.c.2",
              "text": "Describe the parts of an in-line skate and their functions.",
              "resources": [
                {
                  "title": "Types and Parts of Inline Skates (video)",
                  "url": "https://youtu.be/dKYpuWcZ_Ak"
                }
              ]
            },
            {
              "req_id": "3",
              "path": "2.c.3",
              "text": "Describe the required and recommended safety equipment for in-line skating.",
              "resources": [
                {
                  "title": "Safety Gear for In-Line Skating (video)",
                  "url": "https://youtu.be/z10SQgx_kRA"
                },
                {
                  "title": "Putting on Your Protective Gear (video)",
                  "url": "https://youtu.be/GF4fs9-zMq8"
                }
              ]
            },
            {
              "req_id": "4",
              "path": "2.c.4",
              "text": "Explain four essential steps to good in-line skate care.",
              "resources": [
                {
                  "title": "Maintaining and Caring for Your In-Line Skates (video)",
                  "url": "https://youtu.be/67xp-AyQb3g"
                },
                {
                  "title": "Cleaning Your In-Line Skates (video)",
                  "url": "https://youtu.be/Jcery4HP7_s"
                }
              ]
            },
            {
              "req_id": "5",
              "path": "2.c.5",
              "text": "Skate forward with smooth, linked strokes on two feet for at least 100 feet.",
              "resources": [
                {
                  "title": "Skating Forward (video)",
                  "url": "https://youtu.be/fg1eMFnl61U"
                }
              ]
            },
            {
              "req_id": "6",
              "path": "2.c.6",
              "text": "Skate forward and glide at least 15 feet on one skate, then on the other skate.",
              "resources": [
                {
                  "title": "Gliding on One Skate (video)",
                  "url": "https://youtu.be/iwtS9vr4r-Y"
                }
              ]
            },
            {
              "req_id": "7",
              "path": "2.c.7",
              "text": "Stop on command on flat pavement using the heel brake.",
              "resources": [
                {
                  "title": "Braking with In-Line Skates (video)",
                  "url": "https://youtu.be/phN9uBIXkAw"
                }
              ]
            },
            {
              "req_id": "8",
              "path": "2.c.8",
              "text": "Perform a forward crossover.",
              "resources": [
                {
                  "title": "How to Turn on In-Line Skates (video)",
                  "url": "https://youtu.be/RMIRnNr-PeQ"
                },
                {
                  "title": "5 Steps to the Perfect Crossover (video)",
                  "url": "https://youtu.be/2-ULGoMvk24"
                }
              ]
            },
            {
              "req_id": "9",
              "path": "2.c.9",
              "text": "Perform a series of forward, linked swizzles for at least 40 feet.",
              "resources": [
                {
                  "title": "Forward Swizzles (video)",
                  "url": "https://youtu.be/TbNlbqClkGQ"
                }
              ]
            },
            {
              "req_id": "10",
              "path": "2.c.10",
              "text": "Skate backward for at least 40 feet in a series of linked, backward swizzles.",
              "resources": [
                {
                  "title": "Backward Swizzles (video)",
                  "url": "https://youtu.be/t3dO_3vh0Ig"
                }
              ]
            },
            {
              "req_id": "11",
              "path": "2.c.11",
              "text": "From a strong pace, perform a lunge turn around an object predetermined by your counselor.",
              "resources": [
                {
                  "title": "Maneuvering Around Objects (video)",
                  "url": "https://youtu.be/__N7lV59GMI"
                }
              ]
            },
            {
              "req_id": "12",
              "path": "2.c.12",
              "text": "Perform a mohawk.",
              "resources": [
                {
                  "title": "Perform a Mohawk (video)",
                  "url": "https://youtu.be/ytPUoplawVU"
                }
              ]
            },
            {
              "req_id": "13",
              "path": "2.c.13",
              "text": "Perform a series of at least four one-footed downhill slaloms on pavement with a gentle slope.",
              "resources": [
                {
                  "title": "One-Footed Slalom (video)",
                  "url": "https://youtu.be/mzA573nx7W8"
                }
              ]
            },
            {
              "req_id": "14",
              "path": "2.c.14",
              "text": "Describe how to pass a pedestrian or another skater from behind."
            },
            {
              "req_id": "15",
              "path": "2.c.15",
              "text": "Describe at least three ways to avoid an unforeseen obstacle while skating.",
              "resources": [
                {
                  "title": "In-Line Skating Safety (video)",
                  "url": "https://youtu.be/NP5w-A5aRSc"
                }
              ]
            },
            {
              "req_id": "16",
              "path": "2.c.16",
              "text": "Describe two ways to get on and off a curb, and demonstrate at least one of these methods.",
              "resources": [
                {
                  "title": "Maneuvering Curbs (video)",
                  "url": "https://youtu.be/3hq3sID5emE"
                }
              ]
            }
          ],
          "subrequirement_mode": {
            "type": "all"
          }
        },
        {
          "req_id": "d",
          "path": "2.d",
          "text": "Option D—Skateboarding. Do ALL of the following:",
          "is_option": true,
          "resources": [
            {
              "title": "Jamboree - The Park (video)",
              "url": "https://youtu.be/2MEZdB-qooU"
            }
          ],
          "subrequirements": [
            {
              "req_id": "1",
              "path": "2.d.1",
              "text": "Explain the history and evolution of skateboarding.",
              "resources": [
                {
                  "title": "How Has Skateboarding Changed Over the Years (video)",
                  "url": "https://youtu.be/m4AQtoDBC00"
                },
                {
                  "title": "The Wild History of Skateboarding (video)",
                  "url": "https://youtu.be/f9JWlMZa0GE"
                },
                {
                  "title": "The Evolution of Skateboard Tricks! (video)",
                  "url": "https://youtu.be/w1mm3zDNyNI"
                }
              ]
            },
            {
              "req_id": "2",
              "path": "2.d.2",
              "text": "Describe the benefits of skateboarding (physical fitness, balance, coordination, perseverance, and creativity)",
              "resources": [
                {
                  "title": "Benefits of Skateboarding (video)",
                  "url": "https://youtu.be/VAh62ff8rys"
                },
                {
                  "title": "Physics of Skateboarding (video)",
                  "url": "https://youtu.be/6bu_9sI7QTI"
                }
              ]
            },
            {
              "req_id": "3",
              "path": "2.d.3",
              "text": "Explain the safety rules and courtesy guidelines for skateboarding, including right-of-way and communication signals and warnings.",
              "resources": [
                {
                  "title": "Skate Park Safety Rules (video)",
                  "url": "https://youtu.be/Yw9bBDZ2kUo"
                },
                {
                  "title": "How to Ride Skateparks for Beginners (video)",
                  "url": "https://youtu.be/zTVb4bmoiw0"
                },
                {
                  "title": "Skatepark Terrain (video)",
                  "url": "https://youtu.be/qrq6KlaIe8Y?si=4ljJ-qZ2IAeG-tPe"
                },
                {
                  "title": "How to Ride Safely on a Skateboard (video)",
                  "url": "https://player.vimeo.com/video/903371803"
                }
              ]
            },
            {
              "req_id": "4",
              "path": "2.d.4",
              "text": "Explain the protective gear needed to skate safely, including helmet, knee pads, elbow pads, and wrist guards, and show how to wear them correctly.",
              "resources": [
                {
                  "title": "Skateboarding Safety (website)",
                  "url": "https://www.scouting.org/health-and-safety/safety-moments/skateboard-safety/"
                }
              ]
            },
            {
              "req_id": "5",
              "path": "2.d.5",
              "text": "Describe the two main styles of skateboarding (street and vert), and describe common skatepark features (ramps, manual pad, rails, spine, etc.)."
            },
            {
              "req_id": "6",
              "path": "2.d.6",
              "text": "Explain skateboard anatomy (deck, trucks, wheels, hardware, etc.).",
              "resources": [
                {
                  "title": "How to Select a Skateboard (video)",
                  "url": "https://player.vimeo.com/video/901305105"
                }
              ]
            },
            {
              "req_id": "7",
              "path": "2.d.7",
              "text": "Build a board by assembling all pieces (deck, wheels, trucks, hardware, and grip tape) in the proper order.",
              "resources": [
                {
                  "title": "How to Assemble a Skateboard (video)",
                  "url": "https://youtu.be/A6E403WMOXk"
                }
              ]
            },
            {
              "req_id": "8",
              "path": "2.d.8",
              "text": "Explain skateboard maintenance (cleaning, adjusting bolts, and replacing parts).",
              "resources": [
                {
                  "title": "How to Maintain Your Skateboard (website)",
                  "url": "https://www.skatexs.com/blogs/news/9432593-skateboard-maintenance-for-beginners"
                }
              ]
            },
            {
              "req_id": "9",
              "path": "2.d.9",
              "text": "Explain the difference between regular and goofy stance, and demonstrate your preferred stance.",
              "resources": [
                {
                  "title": "Goofy vs. Regular Stance (video)",
                  "url": "https://youtu.be/fdSzhc7HXJ0"
                }
              ]
            },
            {
              "req_id": "10",
              "path": "2.d.10",
              "text": "Demonstrate how to push, cruise, and carve on flat ground.",
              "resources": [
                {
                  "title": "How to Push on a Skateboard (video)",
                  "url": "https://player.vimeo.com/video/901305608"
                },
                {
                  "title": "How to Turn on a Skateboard (video)",
                  "url": "https://player.vimeo.com/video/901305658"
                }
              ]
            },
            {
              "req_id": "11",
              "path": "2.d.11",
              "text": "Show at least two braking and stopping techniques.",
              "resources": [
                {
                  "title": "How to Stop a Skateboard (video)",
                  "url": "https://youtu.be/gLikGjxWCUQ?si=-VfkhrC8oTh1LEvf"
                }
              ]
            },
            {
              "req_id": "12",
              "path": "2.d.12",
              "text": "Do a basic ollie and at least one variation.",
              "resources": [
                {
                  "title": "How to Ollie on Skateboard (video)",
                  "url": "https://player.vimeo.com/video/901305845"
                }
              ]
            },
            {
              "req_id": "13",
              "path": "2.d.13",
              "text": "Show how to drop-in from coping."
            },
            {
              "req_id": "14",
              "path": "2.d.14",
              "text": "Demonstrate THREE skateboarding tricks from the following types:",
              "subrequirements": [
                {
                  "req_id": "a",
                  "path": "2.d.14.a",
                  "text": "Flat ground tricks",
                  "resources": [
                    {
                      "title": "Flatland Tricks (video)",
                      "url": "https://youtu.be/-LwtQJFqNOA"
                    },
                    {
                      "title": "How to Manual on Skateboard (video)",
                      "url": "https://player.vimeo.com/video/901305720"
                    },
                    {
                      "title": "How to Throwdown on Skateboard (video)",
                      "url": "https://player.vimeo.com/video/901305789"
                    },
                    {
                      "title": "How to 180 on a Skateboard (video)",
                      "url": "https://player.vimeo.com/video/901305968"
                    }
                  ]
                },
                {
                  "req_id": "b",
                  "path": "2.d.14.b",
                  "text": "Flip and shove-it tricks",
                  "resources": [
                    {
                      "title": "Flip a Skateboard (video)",
                      "url": "https://youtu.be/MDkVYN6Rk_I"
                    },
                    {
                      "title": "Shove-It (video)",
                      "url": "https://youtu.be/fBAW51ilpLw"
                    }
                  ]
                },
                {
                  "req_id": "c",
                  "path": "2.d.14.c",
                  "text": "Grind and slide tricks",
                  "resources": [
                    {
                      "title": "Grind Tricks (video)",
                      "url": "https://youtu.be/SKrntystOnE"
                    },
