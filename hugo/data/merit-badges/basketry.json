  "requirements": [
    {
      "req_id": "1",
      "path": "1",
      "text": "Do the following:",
      "subrequirements": [
        {
          "req_id": "a",
          "path": "1.a",
          "text": "Explain to your counselor the hazards you are most likely to encounter while using basketry tools and materials, and what you should do to anticipate, help prevent, mitigate, and respond to these hazards.",
          "resources": [
            {
              "title": "Cutting Tool Safety (video)",
              "url": "https://youtu.be/nhB-42oMZF8"
            },
            {
              "title": "Hand Tool Safety (video)",
              "url": "https://youtu.be/jIllqEyw3rA"
            },
            {
              "title": "Health and Safety Tips for Basket Weavers (PDF)",
              "url": "https://sites.google.com/basketweavers.org/missouribasketweaversguild/weaving-tips/health-and-safety"
            }
          ]
        },
        {
          "req_id": "b",
          "path": "1.b",
          "text": "Discuss the prevention of and first-aid treatment for injuries, including cuts, scratches, and scrapes, that could occur while working with basketry tools and materials.",
          "resources": [
            {
              "title": "How to Treat Cuts & Scrapes | First Aid Training (video)",
              "url": "https://youtu.be/L77rERL64zc"
            }
          ]
        }
      ],
      "subrequirement_mode": {
        "type": "all"
      }
    },
    {
      "req_id": "2",
      "path": "2",
      "text": "Do the following:",
      "subrequirements": [
        {
          "req_id": "a",
          "path": "2.a",
          "text": "Show your counselor that you are able to identify the following types of baskets: plaited, coiled, ribbed, and wicker.",
          "resources": [
            {
              "title": "What Are the Four Types of Baskets? (website)",
              "url": "https://www.wicker-basket.co.uk/blogs/news/what-are-the-four-types-of-baskets/"
            },
            {
              "title": "Historical Types of Baskets (video)",
              "url": "https://youtu.be/Z5PttnxrB0I"
            }
          ]
        },
        {
          "req_id": "b",
          "path": "2.b",
          "text": "Describe three different types of weaves to your counselor.",
          "resources": [
            {
              "title": "How to Start a Coiled Basket (video)",
