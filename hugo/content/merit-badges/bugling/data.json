            {
              "title": "The Physics of Music: Playing Fire, Ice and Jelly Trumpets (video)",
              "url": "https://youtu.be/o0Gl4tfh3KA?si=wMNk9m2HLUeNTt06"
            }
          ]
        },
        {
          "req_id": "b",
          "path": "2.b",
          "text": "Compose a bugle call for your troop or patrol to signal a common group activity, such as assembling for mealtime or striking a campsite. Play the call that you have composed before your unit or patrol."
        }
      ],
      "subrequirement_mode": {
        "type": "all"
      }
    },
    {
