        }
      ]
    },
    {
      "req_id": "2",
      "path": "2",
      "text": "Do the following:",
      "subrequirements": [
        {
          "req_id": "a",
          "path": "2.a",
          "text": "Explain and demonstrate how the bugle makes sound, and explain how the bugle is related to other brass wind instruments.",
