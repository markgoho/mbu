  "requirements": [
    {
      "req_id": "1",
      "path": "1",
      "text": "Do the following: Resource: Hazards, Prevention, and First Aid | Produced by Scouting America (video)",
      "resources": [
        {
          "title": "Hazards, Prevention, and First Aid | Produced by Scouting America (video)",
          "url": "https://vimeo.com/1125028263"
        }
      ],
      "subrequirements": [
        {
          "req_id": "a",
          "path": "1.a",
          "text": "Explain to your counselor the most likely hazards you may encounter while participating in cycling activities and what you should do to anticipate, help prevent, mitigate, and respond to these hazards. Explain to your counselor how to ride predictably, be conspicuous, think ahead, and ride ready. Resource: Avoiding Road Hazards (video)",
          "resources": [
            {
              "title": "Avoiding Road Hazards (video)",
              "url": "https://www.youtube.com/watch?v=dcRpBP9WvKg%20"
            }
          ]
        },
        {
          "req_id": "b",
          "path": "1.b",
          "text": "Show that you know first aid for injuries or illnesses that could occur while cycling, including cuts, scratches, concussions, blisters, sunburn, heat exhaustion, heatstroke, hypothermia, frostbite, dehydration, insect stings, tick bites, and snakebite. Explain to your counselor why you should be able to identify the poisonous plants and poisonous animals that are found in your area. Resource: First Aid Guide for Mountain Bikers (video)",
          "resources": [
            {
              "title": "First Aid Guide for Mountain Bikers (video)",
              "url": "https://www.youtube.com/watch?v=oPCWzECMD_4%20"
            }
          ]
        },
        {
          "req_id": "c",
          "path": "1.c",
          "text": "Explain the importance of wearing the right clothing and gear while cycling, including a properly sized and fitted helmet. Know the Scouting America Bike Safety Guidelines.",
          "resources": [
            {
              "title": "Bike Tips: Gear to Make Your Ride More Comfortable (video)",
              "url": "https://www.youtube.com/watch?v=2TYe3APtKtc&list=PLHGEvyG5wuthKCwDfpQIZfTfan4mI6XTe&index=5%20"
            },
            {
              "title": "How to Wear a Helmet (video)",
              "url": "https://www.youtube.com/watch?v=T3u51W0LN2U%20"
            }
          ]
        }
      ],
      "subrequirement_mode": {
        "type": "all"
      }
    },
    {
      "req_id": "2",
      "path": "2",
      "text": "Describe your state and local laws concerning bicycles. Discuss what is the same and what is different from laws applying to motor vehicles. Explain where and how you should ride on roads and streets to include lane position, changing lanes, making left and right turns, and riding through intersections.",
      "resources": [
        {
          "title": "Bicycle Laws and Safe Road Riding | Produced by Scouting America (video)",
          "url": "https://vimeo.com/1125028107"
        },
        {
          "title": "Rules of the Road (video)",
          "url": "https://youtu.be/-Jp0SSAeCiY"
        }
      ]
    },
    {
      "req_id": "3",
      "path": "3",
      "text": "Explain the importance of wearing a properly sized and fitted helmet while cycling and of wearing the right clothing for the weather. Know the Scouting America Bike Safety Guidelines. Resource: Fitting a Bike Helmet (video)",
      "resources": [
        {
          "title": "Fitting a Bike Helmet (video)",
          "url": "https://www.youtube.com/watch?v=hLlXswx0VvQ "
        }
      ]
    },
    {
      "req_id": "4",
      "path": "4",
      "text": "Using a bicycle safety checklist, clean and adjust a bicycle and present it to your counselor for inspection. Do the following: Resource: Checklist, Maintenance, and Inspection | Produced by Scouting America (video)",
      "resources": [
        {
          "title": "Checklist, Maintenance, and Inspection | Produced by Scouting America (video)",
          "url": "https://vimeo.com/1125028194"
        }
      ],
      "subrequirements": [
        {
          "req_id": "a",
          "path": "4.a",
          "text": "Show points that should be checked regularly to make sure the bicycle is safe to ride. Resource: 5 Things to Check Before Every Bike Ride (website)",
          "resources": [
            {
              "title": "5 Things to Check Before Every Bike Ride (website)",
              "url": "https://scoutlife.org/features/169458/5-things-to-check-before-every-bike-ride/"
            }
          ]
        },
        {
          "req_id": "b",
          "path": "4.b",
          "text": "Show how to adjust the saddle and handlebars for a proper fit.",
          "resources": [
            {
              "title": "Bike Tips: Finding and Fitting the Right Bike (video)",
              "url": "https://www.youtube.com/watch?v=dsM9brngVmc&list=PLHGEvyG5wuthKCwDfpQIZfTfan4mI6XTe&index=6%20"
            },
            {
              "title": "How to Set Your Bicycle Seat Height (video)",
              "url": "https://www.youtube.com/watch?v=jh5Zv6Dcn6k%20"
            }
          ]
        },
        {
          "req_id": "c",
          "path": "4.c",
          "text": "Show how to adjust brakes and gear shifting (derailleurs). Resource: Bike Tips: Proper Shifting Technique (video)",
          "resources": [
            {
              "title": "Bike Tips: Proper Shifting Technique (video)",
              "url": "https://www.youtube.com/watch?v=7kc-CHtlQyM&list=PLHGEvyG5wuthKCwDfpQIZfTfan4mI6XTe&index=7%20"
            }
          ]
        },
        {
          "req_id": "d",
          "path": "4.d",
          "text": "Show all points that need regular lubrication."
        },
        {
          "req_id": "e",
          "path": "4.e",
          "text": "Show how to repair a flat by removing the tire, replacing or patching the tube, and remounting the tire.",
          "resources": [
            {
              "title": "Changing a Tire with Disc Brakes | Produced by Scouting America (video)",
              "url": "https://vimeo.com/1125028160"
            },
            {
              "title": "Changing a Tire with Caliper Brakes | Produced by Scouting America (video)",
              "url": "https://vimeo.com/1125028134"
            }
          ]
        },
        {
          "req_id": "f",
          "path": "4.f",
          "text": "Show that the bicycle meets local laws. Resource: Rules of the Road (video)",
          "resources": [
            {
              "title": "Rules of the Road (video)",
              "url": "https://www.youtube.com/watch?v=-Jp0SSAeCiY%20"
            }
          ]
        }
      ],
      "subrequirement_mode": {
        "type": "all"
      }
    },
    {
      "req_id": "5",
      "path": "5",
      "text": "Demonstrate basic bicycle handling skills to your counselor, to include how to properly mount your bicycle, starting and stopping (to include emergency stops), riding in a straight line, turning, shifting gears, scanning, and signaling.",
      "resources": [
        {
          "title": "Mastering Handling Basic Bicycle Handling Skills | Produced by Scouting America (video)",
          "url": "https://vimeo.com/1125028294"
        },
        {
          "title": "Bicycle Safer Journey (video)",
          "url": "https://youtu.be/XMj_95C5ihk"
        },
        {
          "title": "Bike Riding Safety (video)",
          "url": "https://youtu.be/nf5WQXFvrkk"
        }
      ]
    },
    {
