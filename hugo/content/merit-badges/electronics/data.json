{
  "title": "Electronics",
  "slug": "electronics",
  "url": "https://www.scouting.org/merit-badges/electronics/",
  "eagle_required": false,
  "pamphlet_url": "https://filestore.scouting.org/filestore/Merit_Badge_ReqandRes/Pamphlets/Electronics.pdf",
  "requirements": [
    {
      "req_id": "5",
      "path": "5",
      "text": "Do the following:",
      "subrequirements": [
        {
          "req_id": "a",
          "path": "5.a",
          "text": "Show how to solve a simple problem involving current, voltage, and resistance using Ohm's law."
        },
        {
          "req_id": "b",
          "path": "5.b",
          "text": "Tell about the need for and the use of test equipment in electronics. Name three types of test equipment. Tell how they operate."
        },
        {
          "req_id": "c",
          "path": "5.c",
          "text": "Demonstrate to your counselor how to read the colored bands of a resistor to determine its resistance value."
        },
        {
          "req_id": "d",
          "path": "5.d",
          "text": "Explain the differences between Through Hole and Surface Mount assembly technologies and give three advantages of each."
        }
      ],
      "subrequirement_mode": {
        "type": "all"
      }
    },
    {
      "req_id": "6",
      "path": "6",
      "text": "Identify three career opportunities that would use skills and knowledge in Electronics. Pick one and research the training, education, certification requirements, experience, and expenses associated with entering the field. Research the prospects for employment, starting salary, advancement opportunities and career goals associated with this career. Discuss what you learned with your counselor and whether you might be interested in this career."
    },
    {
      "req_id": "1",
      "path": "1",
      "text": "Describe the safety precautions you must exercise when using, building, altering, or repairing electronic devices."
    },
    {
      "req_id": "2",
      "path": "2",
      "text": "Do the following:",
      "subrequirements": [
        {
          "req_id": "a",
          "path": "2.a",
          "text": "Draw a simple schematic diagram. It must show resistors, capacitors, and transistors or integrated circuits. Use the correct symbols. Label all parts."
        },
        {
          "req_id": "b",
          "path": "2.b",
          "text": "Tell the purpose of each part."
        }
      ],
      "subrequirement_mode": {
        "type": "all"
      }
    },
    {
      "req_id": "3",
      "path": "3",
      "text": "Do the following:",
      "subrequirements": [
        {
          "req_id": "a",
          "path": "3.a",
          "text": "Show the right way to solder and desolder."
        },
        {
          "req_id": "b",
          "path": "3.b",
          "text": "Show how to avoid heat damage to electronic components."
        },
        {
          "req_id": "c",
          "path": "3.c",
          "text": "Tell about the function of a printed circuit board. Tell what precautions should be observed when soldering printed circuit boards."
        }
      ],
      "subrequirement_mode": {
        "type": "all"
      }
    },
    {
      "req_id": "4",
      "path": "4",
      "text": "Do the following:",
      "subrequirements": [
        {
          "req_id": "a",
          "path": "4.a",
          "text": "Discuss each of the following with your counselor:",
          "subrequirements": [
            {
              "req_id": "1",
              "path": "4.a.1",
              "text": "How to use electronics for a control purpose."
            },
            {
              "req_id": "2",
              "path": "4.a.2",
              "text": "Explain the basic principles of digital logic."
            },
            {
              "req_id": "3",
              "path": "4.a.3",
              "text": "How to use electronics for three different analog applications."
            }
          ]
        },
        {
          "req_id": "b",
          "path": "4.b",
          "text": "Show how to change three decimal numbers into binary numbers and three binary numbers into decimal numbers."
        },
        {
          "req_id": "c",
          "path": "4.c",
          "text": "Choose ONE of the following THREE projects. For your project, find or create a schematic diagram. To the best of your ability, explain to your counselor how the circuit you built operates.",
          "subrequirements": [
            {
              "req_id": "1",
              "path": "4.c.1",
              "text": "A control device"
            },
            {
              "req_id": "2",
              "path": "4.c.2",
              "text": "A digital circuit"
            },
            {
              "req_id": "3",
              "path": "4.c.3",
