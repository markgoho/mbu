.nav-cards-container{container:nav-cards/inline-size}.nav-card-container{container:nav-card/inline-size;align-self:stretch;display:contents}.nav-cards{display:grid;gap:var(--space-s)}.nav-card{display:grid;gap:var(--space-xs);place-items:center;text-decoration:none;padding:var(--space-s);border:5px solid var(--brown-400);border-radius:var(--spacing-btn-radius);background-color:var(--brown-000)}.nav-card:hover{border-color:var(--teal-500);box-shadow:0 0 10px var(--teal-100)}.nav-card .nav-card__icon{width:var(--space-2xl);height:var(--space-2xl)}.nav-card .nav-card__title{text-align:center;margin:0}.nav-card .nav-card__description{text-align:center;margin:0;grid-column:1/-1}.small{margin-block-start:var(--space-l)}.small .nav-cards{justify-content:center}.small .nav-card{display:block;text-align:center}.small .nav-card__icon{width:var(--space-l);height:var(--space-l)}.small .nav-card__title{font-size:var(--step-1);margin:0}.small .nav-card__description{display:none}@container nav-cards (min-width: 30rem){.small .nav-cards{grid-template-columns:repeat(3, 1fr)}}@container nav-cards (min-width: 50rem){.nav-cards{grid-template-columns:repeat(3, 1fr)}}:root{--spacing-btn-padding-x: 1.25rem;--spacing-btn-radius: 0.625rem}.button{font-family:var(--font-family-main);font-weight:var(--font-weight-boldest);font-size:var(--step-1);color:var(--brown-100);background:var(--teal-500);border-radius:var(--border-radius-md);padding:var(--space-xs) var(--space-s);text-decoration:none;border:none;cursor:pointer;transition:background .2s,color .2s}.button:hover,.button:focus{background:var(--teal-600)}.button-small{font-size:var(--step-0)}.hero{position:relative;padding:var(--space-m);color:var(--brown-300);height:100svh;display:grid;grid-template-columns:auto;grid-template-rows:max-content 1fr max-content}.hero::before{content:"";position:absolute;top:0;left:0;right:0;bottom:0;background-image:url("/assets/images/hero-section-small.avif");background-size:cover;background-position:calc(50% + clamp(0rem,32.8vw - 9.84rem,23rem)) center;z-index:-2}.hero::after{content:"";position:absolute;top:0;left:0;right:0;bottom:0;background:linear-gradient(to right, rgba(0, 0, 0, 0.85) 15%, rgba(0, 0, 0, 0) 86%);z-index:-1}.hero .hero-cta{display:none;align-self:start;justify-self:start}.hero .tagline{font-size:var(--step-6);font-weight:var(--font-weight-boldest);line-height:1.2;margin:0;color:var(--brown-200);max-width:18ch;text-wrap:pretty;margin-block-end:var(--space-xs)}.hero .org-container{display:none;flex-direction:column;color:var(--brown-200)}.hero .org-name{font-weight:var(--font-weight-boldest)}.hero .org-location{font-size:var(--step--2)}.nav-cards-container{margin-block-start:var(--space-l)}@media screen and (max-width: 30rem)and (orientation: portrait){.hero{height:50svh;padding:var(--space-xs);row-gap:var(--space-xs)}.hero .tagline{margin-block-end:0}}@media screen and (min-height: 30rem)and (orientation: portrait){.hero .hero-cta{display:block}}@media screen and (min-height: 37rem){.hero .org-container{display:flex}}@media screen and (min-width: 30rem)and (orientation: landscape){.hero::before{background-image:url("/assets/images/hero-section.avif")}.hero .tagline{margin-block-end:var(--space-2xl)}.hero .hero-cta{display:block}}@media screen and (min-width: 60rem){.hero::after{background:linear-gradient(to right, rgb(0, 0, 0) 35%, rgba(0, 0, 0, 0) 75%)}}